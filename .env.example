# Copy to .env.local for local development:
#   cp .env.example .env.local

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://portal:portal@127.0.0.1:5432/b2b_portal

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used for absolute links in emails/uploads)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Playwright / smoke tests against a deployed environment (optional)
# B2B_BASE_URL=https://your-app.vercel.app

# Vercel Blob (production uploads). Omit locally to use Payload's local disk storage.
# BLOB_READ_WRITE_TOKEN=

# Seed script (local dev only — override in CI via env)
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=local-dev-admin-password
SEED_SALES_EMAIL=sales@local.test
SEED_SALES_PASSWORD=local-dev-sales-password
SEED_VENDOR_A_EMAIL=buyer@pacific-plumbing.local
SEED_VENDOR_A_PASSWORD=local-dev-vendor-a-password
SEED_VENDOR_B_EMAIL=buyer@bay-fixtures.local
SEED_VENDOR_B_PASSWORD=local-dev-vendor-b-password

# Catalog dataset for db:seed (JSON + assets/ sibling folder). Override to load American Standard import.
# SEED_CATALOG_PATH=scripts/seed/catalog/products.json
